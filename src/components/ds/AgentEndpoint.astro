---
interface Props {
  href: string;
  file: string;
  description: string;
}

const { href, file, description } = Astro.props;
---

<a class="agent-endpoint" href={href}>
  <span class="agent-endpoint__body">
    <span class="agent-endpoint__file">{file}</span>
    <span class="agent-endpoint__desc">{description}</span>
  </span>
  <span class="agent-endpoint__arrow" aria-hidden="true">
    <svg width="18" height="18" viewBox="0 0 18 18" fill="none">
      <path d="M4 9h10M10 5l4 4-4 4" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/>
    </svg>
  </span>
</a>

<style>
  .agent-endpoint {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: var(--space-md);
    padding: var(--space-md) var(--space-lg);
    background-color: var(--color-bg);
    border: 1px solid color-mix(in oklch, var(--color-line) 75%, transparent);
    border-radius: var(--radius-lg);
    text-decoration: none;
    color: inherit;
    transition:
      border-color var(--duration-normal) var(--ease-smooth),
      background-color var(--duration-normal) var(--ease-smooth),
      transform var(--duration-fast) var(--ease-spring);
  }

  .agent-endpoint:hover {
    border-color: color-mix(in oklch, var(--color-primary) 35%, var(--color-line));
    background-color: color-mix(in oklch, var(--color-primary) 4%, var(--color-bg));
  }

  .agent-endpoint:focus-visible {
    outline: 2px solid var(--color-focus);
    outline-offset: 2px;
  }

  .agent-endpoint__body {
    display: flex;
    flex-direction: column;
    gap: var(--space-xs);
    min-width: 0;
  }

  .agent-endpoint__file {
    display: inline-block;
    width: fit-content;
    font-family: ui-monospace, "Cascadia Code", "Source Code Pro", monospace;
    font-size: var(--text-caption);
    font-weight: 500;
    color: var(--color-primary-ink);
    background-color: color-mix(in oklch, var(--color-primary) 10%, var(--color-surface));
    border: 1px solid color-mix(in oklch, var(--color-primary) 22%, var(--color-line));
    border-radius: var(--radius-sm);
    padding: 0.2em 0.55em;
  }

  .agent-endpoint__desc {
    font-size: var(--text-secondary);
    color: var(--color-muted);
    line-height: 1.45;
    max-width: none;
  }

  .agent-endpoint__arrow {
    flex-shrink: 0;
    display: flex;
    align-items: center;
    justify-content: center;
    width: 2.25rem;
    height: 2.25rem;
    color: var(--color-primary-ink);
    opacity: 0.85;
  }
</style>
