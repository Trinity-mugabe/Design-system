---
interface Props {
  tone?: "neutral" | "ocean" | "gold" | "green" | "coral";
  class?: string;
}

const { tone = "neutral", class: className = "" } = Astro.props;

const classes = [
  "ds-badge",
  `ds-badge--${tone}`,
  className,
]
  .filter(Boolean)
  .join(" ");
---

<span class={classes}><slot /></span>

<style>
  .ds-badge {
    display: inline-flex;
    align-items: center;
    font-family: var(--font-body);
    font-size: var(--text-caption);
    font-weight: 600;
    line-height: 1;
    padding: 0.3em 0.7em;
    border-radius: var(--radius-sm);
    border: 1px solid transparent;
    white-space: nowrap;
    letter-spacing: 0.01em;
  }

  .ds-badge--neutral {
    background-color: var(--color-badge-neutral-bg);
    color: var(--color-ink);
    border-color: var(--color-line);
  }

  .ds-badge--ocean {
    background-color: var(--color-badge-ocean-bg);
    color: var(--color-badge-ocean-ink);
    border-color: color-mix(in oklch, var(--color-badge-ocean-ink) 25%, transparent);
  }

  .ds-badge--gold {
    background-color: var(--color-badge-gold-bg);
    color: var(--color-badge-gold-ink);
    border-color: color-mix(in oklch, var(--color-badge-gold-ink) 25%, transparent);
  }

  .ds-badge--green {
    background-color: var(--color-badge-green-bg);
    color: var(--color-badge-green-ink);
    border-color: color-mix(in oklch, var(--color-badge-green-ink) 25%, transparent);
  }

  .ds-badge--coral {
    background-color: var(--color-badge-coral-bg);
    color: var(--color-badge-coral-ink);
    border-color: color-mix(in oklch, var(--color-badge-coral-ink) 25%, transparent);
  }
</style>
