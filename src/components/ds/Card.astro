---
interface Props {
  title?: string;
  compact?: boolean;
  glass?: boolean;
  class?: string;
}

const { title, compact = false, glass = false, class: className = "" } = Astro.props;

const classes = [
  "ds-card",
  compact ? "ds-card--compact" : "",
  glass ? "ds-card--glass" : "",
  className,
]
  .filter(Boolean)
  .join(" ");
---

<div class={classes}>
  {title && <p class="ds-card__title">{title}</p>}
  <div class="ds-card__body">
    <slot />
  </div>
</div>

<style>
  .ds-card {
    background-color: var(--color-surface);
    border: 1px solid color-mix(in oklch, var(--color-line) 70%, transparent);
    border-radius: var(--radius-lg);
    padding: var(--space-lg);
    transition:
      border-color var(--duration-normal) var(--ease-smooth),
      box-shadow var(--duration-normal) var(--ease-smooth),
      transform var(--duration-fast) var(--ease-spring);
  }

  .ds-card:hover {
    border-color: color-mix(in oklch, var(--color-primary) 25%, var(--color-line));
    box-shadow: 0 4px 24px color-mix(in oklch, var(--color-primary) 8%, transparent);
  }

  .ds-card--glass {
    background-color: var(--color-surface);
  }

  .ds-card--compact {
    padding: var(--space-md);
  }

  .ds-card__title {
    font-family: var(--font-display);
    font-size: var(--text-subheading);
    font-weight: 600;
    color: var(--color-ink);
    margin: 0 0 var(--space-sm) 0;
    max-width: none;
    letter-spacing: -0.02em;
  }

  .ds-card__body {
    color: var(--color-muted);
    font-size: var(--text-secondary);
    line-height: 1.55;
  }

  .ds-card__body :global(code) {
    font-size: 0.8125em;
  }
</style>
